<%- include('partials/header') %>
<%
  // Texto del botón para cada transición.
  const LABELS = {
    'En revisión': 'Tomar pedido',
    'Confirmado': 'Confirmar pedido',
    'Pendiente de pago': 'Habilitar pago',
    'En preparación': 'Pago recibido: pasar a preparación',
    'Listo para entrega': 'Marcar listo para entrega',
    'Enviado': 'Marcar como enviado',
    'Entregado': 'Marcar como entregado',
  };
  const forward = actions.filter(a => a !== 'Rechazado' && a !== 'Cancelado');
%>
<a class="back-link" href="/admin">Volver a pedidos</a>
<div class="page-head">
  <h1>Pedido #<%= order.number %></h1>
  <span class="status status-<%= statusClass(order.status) %>"><%= order.status %></span>
  <% if (canRemito) { %>
    <a class="button secondary-link" href="/admin/pedidos/<%= order._id %>/remito" target="_blank" rel="noopener">Descargar remito (PDF)</a>
  <% } %>
</div>

<% if (error) { %><p class="alert"><%= error %></p><% } %>
<% if (ok) { %><p class="notice">Estado actualizado. Se notificó al cliente.</p><% } %>

<section class="card client-card">
  <h2>Cliente</h2>
  <% if (order.client) { %>
    <p><strong><%= order.client.name %></strong></p>
    <p><a href="mailto:<%= order.client.email %>"><%= order.client.email %></a></p>
    <p><%= order.client.phone || 'Sin teléfono' %></p>
  <% } else { %>
    <p class="muted">El cliente ya no existe.</p>
  <% } %>
  <p class="muted small">Pedido hecho el <%= formatDate(order.createdAt) %>, <%= order.deliveryMode === 'retiro' ? 'con retiro en el local' : 'con envío a domicilio' %>.</p>
</section>

<% if (actions.length) { %>
  <section class="card actions">
    <h2>Acciones</h2>
    <div class="action-row">
      <% forward.forEach(a => { %>
        <form method="post" action="/admin/pedidos/<%= order._id %>/estado">
          <input type="hidden" name="to" value="<%= a %>">
          <button type="submit"><%= LABELS[a] || a %></button>
        </form>
      <% }) %>
      <% if (actions.includes('Cancelado')) { %>
        <form method="post" action="/admin/pedidos/<%= order._id %>/estado"
          onsubmit="return confirm('¿Cancelar el pedido #<%= order.number %>? No se puede deshacer.');">
          <input type="hidden" name="to" value="Cancelado">
          <button type="submit" class="danger">Cancelar pedido</button>
        </form>
      <% } %>
    </div>

    <% if (actions.includes('Rechazado')) { %>
      <form method="post" action="/admin/pedidos/<%= order._id %>/estado" class="reject-form">
        <input type="hidden" name="to" value="Rechazado">
        <label>Motivo del rechazo (lo ve el cliente)
          <textarea name="reason" rows="2" maxlength="500" required></textarea>
        </label>
        <button type="submit" class="danger">Rechazar pedido</button>
      </form>
    <% } %>
  </section>
<% } %>

<div class="detail-grid">
  <%- include('partials/order-detail', { order }) %>
</div>
<%- include('partials/footer') %>
